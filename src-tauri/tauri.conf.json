{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbital",
  "version": "1.3.6",
  "identifier": "app.orbital.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbital",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Modern SFTP client and server workbench",
    "copyright": "© 2026 Orbital",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OTNCQjEwRDgyNTIxRjEKUldUeElTWFlFTHVUS2Uzb2FJN2lIZzBsSGJnOVNBS2lMendOU0VkTFVjdks4a1ZjS3I1SU1NZHUK",
      "endpoints": [
        "https://github.com/SirojAbdumavlonov/orbital/releases/latest/download/latest.json"
      ]
    }
  }
}
