{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, window dragging from the top bars, native open/save dialogs, and checking for, installing and restarting into app updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "updater:default",
    "process:allow-restart"
  ]
}
