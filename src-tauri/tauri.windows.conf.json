{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbital",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
